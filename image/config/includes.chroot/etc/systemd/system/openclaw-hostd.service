[Unit]
Description=OpenClaw OS read-only host status service
Documentation=https://github.com/jason-allen-oneal/openclaw-os/blob/main/docs/adr/0001-openclaw-os-control-plane.md
After=local-fs.target
Before=openclaw-controller.service
ConditionPathExists=/opt/node/current/bin/node
ConditionPathExists=/usr/lib/openclaw-os/control-plane/services/hostd/src/main.ts

[Service]
Type=simple
User=openclaw-hostd
Group=openclaw-control
ExecStart=/opt/node/current/bin/node --experimental-strip-types /usr/lib/openclaw-os/control-plane/services/hostd/src/main.ts
Restart=on-failure
RestartSec=3
TimeoutStartSec=15
TimeoutStopSec=10
RuntimeDirectory=openclaw-os
RuntimeDirectoryMode=0750
UMask=0007
LimitNOFILE=1024
TasksMax=128

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/node /usr/lib/openclaw-os /var/lib/openclaw

[Install]
WantedBy=multi-user.target
