#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck disable=SC1090,SC1091
source "${OPENCLAW_LIB:-/usr/libexec/openclaw-appliance/lib.sh}"

CREDENTIAL_HELPER="${OPENCLAW_CREDENTIAL_HELPER:-$(dirname "${OPENCLAW_LIB:-/usr/libexec/openclaw-appliance/lib.sh}")/gateway-credential.sh}"
# shellcheck disable=SC1090
source "$CREDENTIAL_HELPER"

ROOT_PREFIX="${OPENCLAW_ROOT:-}"
[[ "$ROOT_PREFIX" == "/" ]] && ROOT_PREFIX=""

root_path() {
  printf '%s%s\n' "$ROOT_PREFIX" "$1"
}

usage() {
  cat <<'USAGE'
Usage: openclaw-appliance <command> [arguments]

Commands:
  status
  setup
  gateway <start|stop|restart|status>
  sandbox <build|status|reset>
  policy <list|status|apply|patch|elevated> ...
  access <status|loopback|lan>
  firewall <render|allow|deny|list> [port] [--no-apply]
  ssh <status|enable|disable>
  backup
  audit [standard|deep]
  update [check|stage|apply|status|cancel|recover] [version-or-tag] [options]
  rollback [version] [--allow-stopped] [--retry-failed]
  releases [--plain]
  network
  logs [lines]
  help

Safe update flow:
  openclaw-appliance update check extended-stable
  openclaw-appliance update stage <exact-version>
  openclaw-appliance update apply

Power-user policy examples:
  openclaw-appliance policy apply developer --acknowledge-risk
  openclaw-appliance policy elevated enable discord id:123 --acknowledge-risk
  openclaw-appliance policy apply locked
USAGE
}

COMMANDS_DIR="${OPENCLAW_APPLIANCE_COMMANDS_DIR:-$(dirname "${OPENCLAW_LIB:-/usr/libexec/openclaw-appliance/lib.sh}")/commands}"
for module in \
  status-sandbox.sh \
  firewall.sh \
  policy.sh \
  gateway-access-setup.sh \
  backup-audit.sh \
  releases.sh \
  system.sh; do
  # shellcheck disable=SC1090
  source "$COMMANDS_DIR/$module"
done

load_command_credential() {
  case "$1" in
    status|sandbox|policy|access|backup|audit|update|rollback)
      openclaw_load_gateway_credential_if_present
      ;;
  esac
}

main() {
  local command="${1:-help}"
  shift || true
  load_command_credential "$command"
  case "$command" in
    status) command_status "$@" ;;
    setup) command_setup "$@" ;;
    gateway) command_gateway "$@" ;;
    sandbox) command_sandbox "$@" ;;
    policy) command_policy "$@" ;;
    access) command_access "$@" ;;
    firewall) command_firewall "$@" ;;
    ssh) command_ssh "$@" ;;
    backup) command_backup "$@" ;;
    audit) command_audit "$@" ;;
    update) command_update "$@" ;;
    rollback) command_rollback "$@" ;;
    releases) command_releases "$@" ;;
    network) command_network "$@" ;;
    logs) command_logs "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "Unknown command: $command" ;;
  esac
}

if [[ "${OPENCLAW_APPLIANCE_LIBRARY_ONLY:-0}" != "1" ]]; then
  main "$@"
fi
