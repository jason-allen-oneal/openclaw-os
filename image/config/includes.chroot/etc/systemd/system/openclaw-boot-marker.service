[Unit]
Description=Signal that OpenClaw OS reached multi-user boot
After=local-fs.target network.target
Before=openclaw-console.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'printf "OPENCLAW_OS_BOOT_OK\n"; if [ -c /dev/ttyS0 ]; then printf "OPENCLAW_OS_BOOT_OK\n" >/dev/ttyS0; fi'
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
