[Unit]
Description=OpenClaw Gateway appliance
Documentation=https://docs.openclaw.ai/gateway
Wants=network-online.target
After=network-online.target openclaw-podman.service
Requires=openclaw-podman.service
ConditionPathExists=/var/lib/openclaw/state/openclaw.json
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/var/lib/openclaw
EnvironmentFile=/etc/openclaw/appliance.env
ExecStartPre=/usr/libexec/openclaw-appliance/preflight
ExecStart=/opt/openclaw/current/bin/openclaw gateway run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
TasksMax=4096

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/openclaw /opt/node
ReadWritePaths=/var/lib/openclaw /srv/openclaw /var/log/openclaw /run/openclaw

[Install]
WantedBy=multi-user.target
